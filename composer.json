{
    "name": "quinos/customer-balance",
    "description": "Customer balance / deposit ledger built with Slim 4 + MySQL (PDO), deployable under XAMPP at localhost/customer-balance",
    "type": "project",
    "require": {
        "php": ">=8.1",
        "ext-pdo": "*",
        "endroid/qr-code": "^5",
        "slim/php-view": "^3.2",
        "slim/psr7": "^1.6",
        "slim/slim": "^4.12"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
